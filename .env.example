# Payload and database
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/database
PAYLOAD_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret

# Canonical origin (no trailing slash).
# Copy this file to .env.development.local for local development.
# Production uses .env.production.local with the real HTTPS domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Search engine ownership verification (leave unused values blank)
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
NEXT_PUBLIC_360_SITE_VERIFICATION=
NEXT_PUBLIC_SOGOU_SITE_VERIFICATION=

# Analytics (scripts are omitted when blank)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

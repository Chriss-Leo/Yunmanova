NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Online reception email notifications (server-only; never prefix with NEXT_PUBLIC_)
SUPPORT_NOTIFICATION_EMAIL=you@example.com
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=service@mail.example.com
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM_EMAIL=service@mail.example.com
SMTP_FROM_NAME=无锡寻光数字在线接待
